{
  "name": "worldspredictor2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LoL Worlds 2026 tracker, simulator and predictor (static SPA for GitHub Pages)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "sync": "node scripts/sync_worlds.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
